            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"advaitas1926@gmail.com\",\n  \"name\": \"advaita suresh\",\n  \"mobileNo\": \"9999999999\",\n  \"githubUsername\": \"your-github-username\",\n  \"rollNo\": \"e0223009\",\n  \"accessCode\": \"DvwEDZ\"\n}"
            },
            "description": "One-time registration to obtain clientID and clientSecret. Can only be called once."
